# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Security / Authentication
JWT_SECRET=super-secret-key-change-this-in-production-hackwithhyderabad-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./memorasupport.db

# LLM Provider Options
# Configurable: "openai", "gemini", or "openai_compatible"
LLM_PROVIDER=openai

# OpenAI Settings (if LLM_PROVIDER=openai or openai_compatible)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini Settings (if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hindsight Memory Engine Settings
# Hindsight Cloud or Self-Hosted Instance
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=your_hindsight_api_key_optional
HINDSIGHT_ENABLED=true
